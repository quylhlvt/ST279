<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_marginVertical="@dimen/dimension_4"
    android:layout_marginEnd="@dimen/dimension_8"
    android:layout_marginBottom="@dimen/dimension_2">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/frame1"
        android:layout_width="@dimen/dimension_0"
        android:layout_height="match_parent"
        android:elevation="@dimen/dimension_2"
        app:cardBackgroundColor="@color/transparent"
        app:cardCornerRadius="@dimen/dimension_8"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeWidth="@dimen/dimension_0">


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/dimension_2"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="@dimen/dimension_8"
            app:layout_constraintDimensionRatio="1:1"
            app:strokeWidth="@dimen/dimension_0">


            <ImageView
                android:id="@+id/imvImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:background="@color/transparent"
                android:scaleType="fitXY"
                android:src="@drawable/img_permission" />


            <!--            imvImage-->


            <!--        sflShimmer-->


        </com.google.android.material.card.MaterialCardView>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
